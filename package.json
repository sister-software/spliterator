{
	"name": "spliterator",
	"version": "9.1.0",
	"description": "Line-delimited iterator library for CSV, NDJSON, and other delimited formats.",
	"keywords": [
		"async-iterable",
		"async-iterator",
		"csv",
		"delimited",
		"excel",
		"iterator",
		"jsonl",
		"line-delimited",
		"ndjson",
		"parallel-processing",
		"spliterator",
		"streaming",
		"tsv",
		"web-streams",
		"worker-threads",
		"xlsx"
	],
	"homepage": "https://github.com/sister-software/spliterator",
	"bugs": {
		"url": "https://github.com/sister-software/spliterator/issues"
	},
	"license": "MIT",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sister-software/spliterator.git"
	},
	"bin": "./out/node/cli/index.js",
	"files": [
		"out/index.js",
		"out/index.js.map",
		"out/index.d.ts",
		"out/index.d.ts.map",
		"out/web.js",
		"out/web.js.map",
		"out/web.d.ts",
		"out/web.d.ts.map",
		"out/lib/**/*",
		"out/node/**/*"
	],
	"type": "module",
	"imports": {
		"#core/*": "./out/lib/core/*.js",
		"#internal/*": "./out/lib/internal/*.js",
		"#formats/*": "./out/lib/formats/*.js",
		"#io/*": "./out/lib/io/*.js",
		"#iterators/*": "./out/lib/iterators/*.js",
		"#parallel/*": "./out/lib/parallel/*.js",
		"#cli/*": "./out/node/cli/*.js",
		"#fs/*": "./out/node/fs/*.js",
		"#test/*": "./test/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		".": "./out/index.js",
		"./web": "./out/web.js",
		"./casing": "./out/lib/formats/casing.js",
		"./node/fs": "./out/node/fs/index.js",
		"./merge-async-iterators": "./out/lib/parallel/merge-async-iterators.js",
		"./parallel-map-runtime": "./out/lib/parallel/parallel-map-runtime.js",
		"./segment-runtime": "./out/lib/parallel/segment-runtime.js",
		"./segment-workers": "./out/lib/parallel/segment-workers.js"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"check-types": "tsc --build .",
		"clean": "tsc -b --clean",
		"compile": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b",
		"demo": "node out/examples/simple-iteration.js",
		"lint": "run-s lint:oxlint lint:oxfmt",
		"lint:oxlint": "oxlint",
		"lint:oxfmt": "oxfmt --check .",
		"lint:fix": "run-s fix:oxlint format",
		"fix:oxlint": "oxlint --fix",
		"format": "oxfmt .",
		"test": "yarn compile && vitest"
	},
	"devDependencies": {
		"@sister.software/oxfmt-config": "^14.0.0",
		"@sister.software/oxlint-config": "^14.0.0",
		"@sister.software/tsconfig": "^14.0.0",
		"@types/node": "^26.6.4",
		"colorette": "^2.0.20",
		"npm-run-all": "^4.1.5",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"path-ts": "^2.5.0",
		"read-excel-file": "^9.3.10",
		"type-fest": "^5.10.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"write-excel-file": "^4.1.1"
	},
	"peerDependencies": {
		"read-excel-file": "^9.3.5",
		"type-fest": "^5.8.0",
		"write-excel-file": "^4.1.1"
	},
	"peerDependenciesMeta": {
		"read-excel-file": {
			"optional": true
		},
		"type-fest": {
			"optional": true
		},
		"write-excel-file": {
			"optional": true
		}
	},
	"engines": {
		"node": ">= 22.18.0"
	},
	"packageManager": "yarn@4.18.0"
}
