{
	"$comment": "CSV, TSV and PSV rows. Expected values are written from the semantics table in docs/v10.md, never captured from an implementation. A case's own `format` overrides the file's.",
	"format": "csv",
	"cases": [
		{ "name": "object rows keyed by the header as written", "input": "name,Last Name\nAda,Lovelace\nBob,Hope\n", "expect": [{ "name": "Ada", "Last Name": "Lovelace" }, { "name": "Bob", "Last Name": "Hope" }] },
		{ "name": "empty input", "input": "", "expect": [] },
		{ "name": "a header alone yields no rows", "input": "a,b\n", "expect": [] },
		{ "name": "no header means array rows", "input": "a,b\nc,d", "options": { "header": false }, "expect": [["a", "b"], ["c", "d"]] },
		{ "name": "a quoted delimiter and a quoted newline", "input": "h1,h2\n\"a,x\",b\n\"c\nd\",e\n", "expect": [{ "h1": "a,x", "h2": "b" }, { "h1": "c\nd", "h2": "e" }] },
		{ "name": "a doubled quote unescapes", "input": "h\n\"a\"\"b\"\n", "expect": [{ "h": "a\"b" }] },
		{ "name": "an empty quoted cell and a quote-only cell", "input": "h1,h2\n\"\",\"\"\"\"\n", "expect": [{ "h1": "", "h2": "\"" }] },
		{ "name": "a quote inside a cell is a literal character", "input": "h1,h2\na\"b\"c,d\n", "expect": [{ "h1": "a\"b\"c", "h2": "d" }] },
		{ "name": "trim runs after unquoting, header included", "input": " Name , Age \n \" Ada \" , 36 \r\nBob,  41\n", "expect": [{ "Name": "Ada", "Age": "36" }, { "Name": "Bob", "Age": "41" }] },
		{ "name": "padding around quotes is trimmed and the quotes removed", "input": "h\n  \"x\"  \n", "expect": [{ "h": "x" }] },
		{ "name": "an unquoted value that still has edge quotes is not unquoted twice", "input": "h\n\"\"\"a\"\"\"\n", "expect": [{ "h": "\"a\"" }] },
		{ "name": "trim off keeps padding", "input": "a, b \n 1 ,2\n", "options": { "header": false, "trim": false }, "expect": [["a", " b "], [" 1 ", "2"]] },
		{ "name": "CRLF rows by default", "input": "a,b\r\nc,d\r\n", "options": { "header": false, "trim": false }, "expect": [["a", "b"], ["c", "d"]] },
		{ "name": "crlf off keeps the carriage return in the last cell", "input": "a,b\r\nc,d\r\n", "options": { "header": false, "trim": false, "crlf": false }, "expect": [["a", "b\r"], ["c", "d\r"]] },
		{ "name": "a short row fills missing columns with empty strings", "input": "a,b,c\n1\n", "expect": [{ "a": "1", "b": "", "c": "" }] },
		{ "name": "array rows keep a short row short", "input": "a,b,c\n1\n", "options": { "mode": "array" }, "expect": [["1"]] },
		{ "name": "cells past the header are keyed by index", "input": "a\n1,2,3\n", "expect": [{ "a": "1", "column_1": "2", "column_2": "3" }] },
		{ "name": "entries rows", "input": "a,b\n1,2\n3\n", "options": { "mode": "entries" }, "expect": [[["a", "1", 0], ["b", "2", 1]], [["a", "3", 0], ["b", "", 1]]] },
		{ "name": "a repeated header is an error in object mode", "input": "k,k\n1,2\n", "error": { "type": "DuplicateHeader", "column": "k" } },
		{ "name": "a repeated header is kept in entries mode", "input": "k,k\n1,2\n", "options": { "mode": "entries" }, "expect": [[["k", "1", 0], ["k", "2", 1]]] },
		{ "name": "a repeated header is kept in array mode", "input": "k,k\n1,2\n", "options": { "mode": "array" }, "expect": [["1", "2"]] },
		{ "name": "normalizeKeys snake-cases, lowercases all-caps names and suffixes repeats", "input": "First Name,LAST NAME,first name\nA,B,C\n", "options": { "normalizeKeys": true }, "expect": [{ "first_name": "A", "last_name": "B", "first_name_2": "C" }] },
		{ "name": "normalizeKeys splits camel case and acronyms", "input": "itemName,XMLHttpRequest,Some-Thing,U.S.A. Code\n1,2,3,4\n", "options": { "normalizeKeys": true }, "expect": [{ "item_name": "1", "xml_http_request": "2", "some_thing": "3", "usa_code": "4" }] },
		{ "name": "normalizeKeys keeps caseless scripts", "input": "영업상태명,주소 (도로명)\n1,2\n", "options": { "normalizeKeys": true }, "expect": [{ "영업상태명": "1", "주소_도로명_": "2" }] },
		{ "name": "a suffixed name that collides with a literal header keeps counting", "input": "a_2,a,a\n1,2,3\n", "options": { "normalizeKeys": true }, "expect": [{ "a_2": "1", "a": "2", "a_3": "3" }] },
		{ "name": "an unterminated quote is an error naming the record's byte offset", "input": "h1,h2\n5\" pipe,b\n", "error": { "type": "UnterminatedQuote", "byteOffset": 6 } },
		{ "name": "allowUnterminatedQuote reads the rest as one record", "input": "h1,h2\n5\" pipe,b\n", "options": { "mode": "array", "trim": false, "allowUnterminatedQuote": true }, "expect": [["5\" pipe,b\n"]] },
		{ "name": "the records before an open quote are yielded first", "input": "h\nok\n\"open\n", "expectBeforeError": [{ "h": "ok" }], "error": { "type": "UnterminatedQuote", "byteOffset": 5 } },
		{ "name": "a BOM before the header", "input": "\ufeffid,name\n1,x", "expect": [{ "id": "1", "name": "x" }] },
		{ "name": "empty rows are skipped", "input": "a\n\n1\n\n", "expect": [{ "a": "1" }] },
		{ "name": "a whitespace-only row is not empty", "input": "a,b\n   \n1,2", "expect": [{ "a": "", "b": "" }, { "a": "1", "b": "2" }] },
		{ "name": "drop and take count data rows", "input": "h\n1\n2\n3\n4", "options": { "drop": 1, "take": 2 }, "expect": [{ "h": "2" }, { "h": "3" }] },
		{ "name": "multi-byte UTF-8 beside quotes", "input": "h1,h2,h3\nBesançon,\"Saint-Étienne, Loire\",Zürich\n", "options": { "mode": "array" }, "expect": [["Besançon", "Saint-Étienne, Loire", "Zürich"]] },
		{ "name": "invalid UTF-8 in a cell decodes lossily", "input": { "base64": "aAr/eAo=" }, "expect": [{ "h": "\ufffdx" }] },
		{ "name": "a trailing column delimiter is an empty cell", "input": "a,b\n1,\n", "expect": [{ "a": "1", "b": "" }] },
		{ "name": "a custom column delimiter", "input": "a;b\n1;\"2;3\"", "options": { "columnDelimiter": ";" }, "expect": [{ "a": "1", "b": "2;3" }] },
		{ "name": "TSV treats quotes as data by default", "format": "tsv", "input": "name\tplace\nA\tOvrag Kyzylak\"on\nB\tx\n", "expect": [{ "name": "A", "place": "Ovrag Kyzylak\"on" }, { "name": "B", "place": "x" }] },
		{ "name": "TSV quote handling can be turned on", "format": "tsv", "input": "a\tb\n\"x\ty\"\tz\n", "options": { "enableQuoteHandling": true }, "expect": [{ "a": "x\ty", "b": "z" }] },
		{ "name": "PSV splits on pipes and handles quotes", "format": "psv", "input": "a|b\n\"1|2\"|3", "expect": [{ "a": "1|2", "b": "3" }] }
	]
}
